# ============================================================================
# AInvest Platform — environment configuration
# Single local user, no auth. Copy to `.env` and fill in what you have.
# The stack boots with the defaults below using only keyless/local pieces:
# Ollama for AI, Yahoo/Stooq for market data, local ChromaDB for memory.
# Cloud data + AI providers activate as soon as their keys are present.
# ============================================================================

# ---- app ----
ENV=dev
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- MongoDB (market history, AI reasoning, news, conversations, watchlists) ----
MONGO_URI=mongodb://mongo:27017
MONGO_DB=ainvest

# ---- Redis (cache, queue, websocket state) ----
REDIS_URL=redis://redis:6379/0

# ---- ChromaDB (RAEM episodic memory + news RAG, from the notebook) ----
# Persistent path INSIDE the container; mapped to the `chromadata` docker volume
# so memories survive restarts. Never in-memory.
CHROMA_DB_PATH=/data/chroma

# ---- embeddings (provider chosen here; business logic stays provider-agnostic)
# Options: ollama (default, local/keyless) | openai | sentence-transformers
EMBEDDING_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text          # used when EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_MODEL_ST=all-MiniLM-L6-v2

# ---- AI engine — TradingAgents is the ONLY AI engine in this app. ----
# The actual execution path (pipeline/llm.py) mirrors the notebook exactly:
# it builds a langchain chat model directly, the same way the notebook does.
# ✅ CHANGED: default provider is now Anthropic (Claude Sonnet 5) instead of
# local Ollama/Qwen — set ANTHROPIC_API_KEY below. Ollama is still fully
# supported if you want to switch back: RAEM_LLM_PROVIDER=ollama +
# RAEM_LLM_MODEL=qwen2.5:7b (pull it first with `ollama pull qwen2.5:7b`).
#
# RAEM_LLM_PROVIDER: anthropic (default) | ollama | openai | groq
RAEM_LLM_PROVIDER=anthropic
RAEM_LLM_MODEL=claude-sonnet-5
RAEM_LLM_TEMPERATURE=0
# docker-compose.yml runs its own `ollama` service and overrides this to
# http://ollama:11434 for api/worker/celery_worker automatically. Only
# change this if you're running the backend outside docker-compose (e.g.
# `uvicorn` directly on a host with Ollama installed at a different address).
OLLAMA_BASE_URL=http://ollama:11434

# ---- AI provider API keys (ANTHROPIC_API_KEY is required with the default
# provider above; the others are optional, only needed if you switch) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GROQ_API_KEY=

# ---- market-data providers ----
# ✅ CHANGED: FMP_API_KEY and FINNHUB_API_KEY are now REQUIRED — the AI
# pipeline's own data layer (app/pipeline/data_providers.py) uses FMP for
# price/fundamentals and Finnhub for news/sentiment, replacing tradingagents'
# yfinance-backed tools. DEFAULT_MARKET_PROVIDER below is unrelated — it only
# controls the separate lightweight quote facade (services/market_data.py)
# used for watchlist/dashboard display, which still defaults to keyless Yahoo.
DEFAULT_MARKET_PROVIDER=yahoo
FMP_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
FRED_API_KEY=
NEWSAPI_KEY=

# ---- worker ----
WORKER_INTERVAL_SECONDS=300
DEFAULT_WATCH_TICKERS=AAPL,MSFT,NVDA,TSLA,AMZN

# ---- scheduled dataset export (worker container) ----
# Every DATASET_JOB_INTERVAL_SECONDS (default 2h), while the market is open
# (if DATASET_JOB_MARKET_HOURS_ONLY=true), runs one full analysis per
# watchlist ticker and appends the decision + key metrics to
# /data/dataset/{TICKER}.csv (persisted in the `datasetdata` docker volume) —
# building a growing historical dataset over time. Set
# DATASET_JOB_MARKET_HOURS_ONLY=false to also run on weekends/after-hours.
DATASET_CSV_PATH=/data/dataset
DATASET_JOB_INTERVAL_SECONDS=7200
DATASET_JOB_MARKET_HOURS_ONLY=true
DATASET_JOB_PER_TICKER_TIMEOUT_SECONDS=1800
